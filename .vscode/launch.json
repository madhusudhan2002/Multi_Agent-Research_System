{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run demo.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/demo.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run evals",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/evals/run_evals.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run API server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["api.main:app", "--reload"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
