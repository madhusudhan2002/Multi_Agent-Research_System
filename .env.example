# === LLM Provider ===
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model used by all agents. Change if a newer Claude model is available.
MODEL_NAME=claude-sonnet-4-5-20250929

# === Web Search (optional) ===
# Get a free key at https://tavily.com/  (1000 free searches/month)
# If left blank, the system automatically falls back to MOCK search results
# so the demo still runs end-to-end without any external API.
TAVILY_API_KEY=

# === Agent behavior ===
MAX_RESEARCH_SUBTASKS=4
MAX_CRITIC_LOOPS=1
REQUEST_TIMEOUT_SECONDS=60
MAX_RETRIES=3
